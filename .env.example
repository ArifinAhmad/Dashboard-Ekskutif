APP_NAME="Dashboard SIMRS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS hanya efektif pada OS yang mendukung process forking.
# Jika diaktifkan, jalankan `php artisan serve --no-reload`.
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Wajib diisi melalui secret manager/environment sebelum menjalankan SuperAdminSeeder.
SUPER_ADMIN_NAME=Arifin
SUPER_ADMIN_EMAIL=arifinahmad1207@gmail.com
SUPER_ADMIN_PASSWORD=arifin100794

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Wajib menggunakan akun database dengan privilege SELECT saja.
SIMRS_DB_DRIVER=mysql
SIMRS_DB_HOST=127.0.0.1
SIMRS_DB_PORT=3306
SIMRS_DB_DATABASE=sikori
SIMRS_DB_USERNAME=root
SIMRS_DB_PASSWORD=
SIMRS_DB_TIMEOUT=5
SIMRS_IGD_CODE=IGDK
SIMRS_CACHE_TTL=300
SIMRS_DASHBOARD_REFRESH_SECONDS=600
SIMRS_CACHE_STORE=redis
SIMRS_REPORT_CACHE_VERSION=v2
SIMRS_REPORT_CACHE_TODAY_TTL=120
SIMRS_REPORT_CACHE_RECENT_TTL=900
SIMRS_REPORT_CACHE_HISTORY_TTL=86400
SIMRS_REPORT_CACHE_RECENT_DAYS=7
SIMRS_DATE_RANGE_MAX_DAYS=366
SIMRS_REPORT_PAGE_SIZE=10
SIMRS_SYNC_EXPORT_MAX_ROWS=25000
SIMRS_SYNC_PDF_MAX_ROWS=5000

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
